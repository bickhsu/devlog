{
  "name": "devlog",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @devlog/design-system dev",
    "build": "bun run --workspaces --if-present build",
    "lint": "bun run --workspaces --if-present lint",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "ui:add": "bunx --bun shadcn@latest add -c packages/ui",
    "test": "bun run --workspaces --if-present test",
    "lint:rust": "bun run --filter @devlog/desktop lint:rust",
    "typecheck:rust": "bun run --filter @devlog/desktop typecheck:rust",
    "validate": "bun run lint && bun run typecheck && bun run lint:rust && bun run typecheck:rust && bun run test && bun run build"
  }
}
